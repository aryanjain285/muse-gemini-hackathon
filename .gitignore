.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── scratch ──────────────────────────────────────────────────────────────────
scratch/
tmp/
*.local

# ── local agent tooling ──────────────────────────────────────────────────────
# Editor/agent configuration and the design skill library used while building.
# Local tooling rather than part of the product; un-ignore if you want them public.
.agents/
.claude/
