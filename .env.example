# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cost controls ---------------------------------------------------------------
# Hard lifetime ceiling in USD. The CostGovernor refuses any call that would
# cross this line. Spend is persisted in workspace/muse.db and survives restarts.
MUSE_BUDGET_USD=5.00

# Default generation profile: local | wiring | standard | hero | max
#   local     $0.00  no network at all — deterministic engine end to end
#   wiring    ~$0.02 real Director + Critic, deterministic media
#   standard  ~$0.37 + real keyframes + real Lyria soundtrack
#   hero      ~$0.67 + one real veo-3.1-lite hero shot
#   max       ~$1.28 nano-banana-pro keyframes + veo-3.1-fast 1080p
MUSE_PROFILE=local

# Cache model responses on disk so re-runs of an identical request cost $0.
MUSE_CACHE=1

# Whole-project safety deadline in ms. Past it, optional retries stop and the
# composer runs with whatever assets exist. Raise it if you render long locally.
MUSE_DEADLINE_MS=900000
